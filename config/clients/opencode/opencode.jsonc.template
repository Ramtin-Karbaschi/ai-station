// AI Station OpenCode 1.18 template. No secrets. ai opencode configure injects apiKey.
{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["ai-station"],
  "model": "ai-station/Qwen3-Coder-30B-A3B-Instruct-Q4",
  "small_model": "ai-station/Qwen3-Coder-30B-A3B-Instruct-Q4",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": false,
  "lsp": {
    "pyright": {
      "command": ["/usr/local/bin/pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "bash": {
      "command": ["/usr/local/bin/bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    }
  },
  "formatter": {
    "ruff": {
      "command": ["/usr/local/bin/ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    },
    "shfmt": {
      "command": ["/usr/bin/shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash"]
    }
  },
  "snapshot": true,
  "watcher": {
    "ignore": [
      ".git/**",
      ".venvs/**",
      "graphify-out/**",
      "benchmarks/results/**"
    ]
  },
  "skills": {
    "paths": ["/opt/ai-station/config/skills"]
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "ask",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "attachment_read": "allow",
    "external_directory": "deny",
    "doom_loop": "ask",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2048
  },
  "provider": {
    "ai-station": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Station",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "__AI_STATION_OPENCODE_API_KEY__",
        "timeout": 600000
      },
      "models": {
        "Qwen3-Coder-30B-A3B-Instruct-Q4": {
          "name": "Qwen3 Coder",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "Qwen3.6-35B-A3B-UD-Q4_K_M": {
          "name": "Qwen3.6 General",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 2048
          }
        },
        "DeepSeek-R1-Distill-Qwen-32B-Q4_K_M": {
          "name": "DeepSeek R1 Reasoning",
          "reasoning": true,
          "tool_call": false,
          "limit": {
            "context": 8192,
            "output": 2048
          }
        },
        "Ornith-1.0-35B-Q4_K_M": {
          "name": "Ornith Coding",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "steps": 40,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow",
        "skill": "allow",
        "lsp": "allow",
        "attachment_read": "allow",
        "external_directory": "deny"
      }
    },
    "plan": {
      "steps": 20
    },
    "title": {
      "disable": true
    },
    "summary": {
      "disable": true
    },
    "general": {
      "steps": 16
    },
    "explore": {
      "steps": 16
    }
  }
}
