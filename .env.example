# AI Station environment template
# Copy to .env and fill required values. Never commit the real .env.

COMPOSE_FILE=compose.yml:compose.models.yml:compose.hardening.yaml:compose.local-builds.yaml:compose.images.lock.yaml
COMPOSE_PROJECT_NAME=ai-station
AI_STATION_NAME=ai-station

# Host paths
MODELS_DIR=/srv/ai-station/models
AI_STATION_PROVIDERS=/opt/ai-station/config/providers.yaml

# Ports (all published on 127.0.0.1 by Compose)
WEBUI_PORT=3000
LITELLM_PORT=4000
GATEWAY_PORT=8888
UI_GATEWAY_PORT=8890
SEARXNG_PORT=8889
GENERAL_LLM_PORT=8082
CODER_LLM_PORT=8083
REASONING_LLM_PORT=8084
VISION_LLM_PORT=8085
ORNITH_LLM_PORT=8086
EMBEDDER_PORT=8090
RERANKER_PORT=8091
TIKA_PORT=9998

# Optional. Host directory bind-mounted as ComfyUI output (ADR-016).
# Override with: ai output set media PATH
# AI_STATION_COMFYUI_OUTPUT=/srv/ai-station/runtime/comfyui/output

# llama.cpp model files (also mirrored in .env.models). docker compose
# interpolates ${VAR} in compose.models.yml from THIS file (--env-file .env),
# not from .env.models's env_file: block, so any profile's context override
# must be set here too or the compose.models.yml default silently wins.
LLM_GENERAL_MODEL_FILE=general/qwen3.6-35b-a3b-ud-q4_k_m.gguf
LLM_GENERAL_CONTEXT=8192
# Long-context clients can use the 32768-token runtime ceiling; individual
# clients may deliberately advertise a smaller verified context window.
LLM_CODER_CONTEXT=32768
EMBEDDING_MODEL_FILE=embedding/qwen3-embedding-0.6b-q8_0.gguf
EMBEDDING_CONTEXT=8192

# Secrets — generate locally
POSTGRES_USER=ai
POSTGRES_PASSWORD=
POSTGRES_DB=ai_station
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_DATABASE_URL=
OPENWEBUI_DATABASE_URL=
PGVECTOR_DB_URL=
WEBUI_SECRET_KEY=
UI_USERNAME=admin
UI_PASSWORD=
