# AI Station environment template
# Copy to .env and fill required values. Never commit the real .env.

COMPOSE_FILE=compose.yml:compose.models.yml:compose.comfyui.experimental.yaml:compose.hardening.yaml:compose.local-builds.yaml:compose.images.lock.yaml
COMPOSE_PROJECT_NAME=ai-station
AI_STATION_NAME=ai-station

# Host paths
MODELS_DIR=/srv/ai-station/models
AI_STATION_PROVIDERS=/opt/ai-station/config/providers.yaml

# Ports (all published on 127.0.0.1 by Compose)
WEBUI_PORT=3000
LITELLM_PORT=4000
GATEWAY_PORT=8888
UI_GATEWAY_PORT=8890
SEARXNG_PORT=8889
GENERAL_LLM_PORT=8082
CODER_LLM_PORT=8083
REASONING_LLM_PORT=8084
VISION_LLM_PORT=8085
ORNITH_LLM_PORT=8086
EMBEDDER_PORT=8090
RERANKER_PORT=8091
ASR_PORT=8092
PADDLEOCR_VL_PORT=8093
TIKA_PORT=9998
N8N_PORT=5678

# Optional. Host directory bind-mounted as ComfyUI output (ADR-016).
# Override with: ai output set media PATH
# AI_STATION_COMFYUI_OUTPUT=/srv/ai-station/runtime/comfyui/output

# llama.cpp model files (also mirrored in .env.models). docker compose
# interpolates ${VAR} in compose.models.yml from THIS file (--env-file .env),
# not from .env.models's env_file: block, so any profile's context override
# must be set here too or the compose.models.yml default silently wins.
LLM_GENERAL_MODEL_FILE=qwen38/qwen3.8-27b-ud-q4_k_m.gguf
LLM_GENERAL_CONTEXT=262144
# Context: Qwen3.8 general/reasoning measured 262144 with Q4 KV + flash-attn
# (138801-token ingest, 2026-08-27). Ornith/coder stay at last measured 8192.
LLM_CODER_MODEL_FILE=ornith/ornith-1.5-35b-q4_k_m.gguf
LLM_CODER_CONTEXT=8192
REASONING_MODEL_FILE=qwen38/qwen3.8-27b-ud-q4_k_m.gguf
REASONING_CONTEXT=262144
VISION_MODEL_FILE=qwen38/qwen3.8-27b-ud-q4_k_m.gguf
VISION_MMPROJ_FILE=qwen38/mmproj-f16.gguf
EMBEDDING_MODEL_FILE=embedding/qwen3-embedding-8b-q4_k_m.gguf
EMBEDDING_CONTEXT=8192

# Secrets — generate locally
POSTGRES_USER=ai
POSTGRES_PASSWORD=
POSTGRES_DB=ai_station
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_DATABASE_URL=
OPENWEBUI_DATABASE_URL=
PGVECTOR_DB_URL=
WEBUI_SECRET_KEY=
UI_USERNAME=admin
UI_PASSWORD=

# Optional n8n workflow client (ADR-021). Generated on install / first start.
# Never commit the real value.
N8N_ENCRYPTION_KEY=
# LiteLLM virtual key for n8n Instance AI. Set by: ai n8n configure
N8N_LLM_API_KEY=
# n8n sandbox (generated on ai n8n start). Never commit. No host ports.
N8N_SANDBOX_SERVICE_API_KEY=
N8N_SANDBOX_RUNNER_REGISTRATION_TOKEN=
N8N_SANDBOX_RUNNER_API_KEY=
